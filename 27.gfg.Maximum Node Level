

/* Structure of a Tree Node
class Node {
    int data;
    Node left;
    Node right;

    Node(int val) {
        data = val;
        left = right = null;
    }
};
*/
class Solution {
    public int maxNodeLevel(Node root) {
        if(root==null){
            return -1;
        }
        Queue<Node> q=new LinkedList<>();
        q.add(root);
        int level=0;
        int maxLevel=0;
        int maxCount=0;
        while(!q.isEmpty()){
            int size=q.size();
            if(size>maxCount){
                maxCount=size;
                maxLevel=level;
            }
            for (int i = 0; i < size; i++) {
                          Node curr = q.poll();

                          if (curr.left != null) {
                              q.add(curr.left);
                          }

                          if (curr.right != null) {
                              q.add(curr.right);
                          }
                      }

                      level++;
                  }
        
        return maxLevel;
    }
}
